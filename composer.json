{
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.2.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "application/common": "^2.2",
        "monolog/monolog": "^2.8",
        "doctrine/dbal": "^2.13",
        "doctrine/orm": "^2.13",
        "doctrine/migrations": "^2.3",
        "guzzlehttp/guzzle": "^7.5",
        "bjoern-goetschke/psr7-base-url": "^3.0",
        "bjoern-goetschke/datetime": "^3.0",
        "enqueue/dbal": "0.10.17",
        "league/openapi-psr7-validator": "^0.21.0",
        "league/oauth2-server": "^8.5",
        "beberlei/assert": "^3.3",
        "zircote/swagger-php": "^4.7",
        "ext-openssl": "*",
        "symfony/mailer": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.3",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.9",
        "phpstan/phpstan-strict-rules": "^1.4",
        "phpstan/extension-installer": "^1.2",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpat/phpat": "0.10.9"
    },
    "autoload": {
        "psr-4": {
            "Application\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Application\\Test\\": "tests/src/"
        }
    },
    "repositories": [
        {
            "type": "artifact",
            "url": "libs/"
        }
    ],
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "composer/*": true,
            "phpstan/extension-installer": true
        }
    }
}
