# A unique name for the current project
COMPOSE_PROJECT_NAME=

# Apache
APACHE_HOST_PORT=127.0.0.1:80

# Settings for the development database
MARIADB_DEV_USER=mariadb-dev-user
MARIADB_DEV_PASSWORD=mariadb-dev-password
MARIADB_DEV_ROOT_PASSWORD=mariadb-dev-root-password
MARIADB_DEV_DATABASE=mariadb-dev-database
MARIADB_DEV_HOST_PORT=127.0.0.1:3306

# Settings for the database used for automated tests
MARIADB_TEST_USER=mariadb-test-user
MARIADB_TEST_PASSWORD=mariadb-test-password
MARIADB_TEST_ROOT_PASSWORD=mariadb-test-root-password
MARIADB_TEST_DATABASE=mariadb-test-database
MARIADB_TEST_HOST_PORT=127.0.0.1:3307

# Available [trace|debug|profile]. Use comma separated values for multiple modes
# Use "off" to disable xdebug
XDEBUG_MODES=trace,debug
XDEBUG_REMOTE_HOST=host.docker.internal
XDEBUG_REMOTE_PORT=9003
XDEBUG_IDE_KEY=PHPSTORM
XDEBUG_ENABLE_LOG=no

#
# Autogenerated - Only touch if you are 100% sure what you are doing!
#
